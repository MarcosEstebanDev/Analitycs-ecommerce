# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://analitycs:your_password@localhost:5432/analitycs

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis URL for BullMQ job queues
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secret — use a long random string in production (openssl rand -hex 64)
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_64
# Refresh token secret — different from JWT_SECRET
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origin for CORS requests (e.g. your frontend URL in production)
CORS_ORIGIN=http://localhost:4200

# ── Sentry (optional — error tracking) ──────────────────────────────────────
# Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# ── Stripe (optional — billing features) ────────────────────────────────────# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for Checkout Sessions (from https://dashboard.stripe.com/products)
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# ── Shopify Connector ────────────────────────────────────────────────────────
# Shopify webhook HMAC secret (from Shopify Partner Dashboard > Webhooks)
SHOPIFY_API_SECRET=your_shopify_api_secret

# ── WooCommerce Connector ─────────────────────────────────────────────────────
# WooCommerce webhook secret (set in WooCommerce > Settings > Advanced > Webhooks)
WOO_WEBHOOK_SECRET=your_woo_webhook_secret

# ── Email (optional — alert notifications) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@your-domain.com