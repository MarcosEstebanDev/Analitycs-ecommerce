# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://analitycs:your_password@localhost:5432/analitycs

# ── Redis ─────────────────────────────────────────────────────────────────────
# Redis URL for BullMQ job queues
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secret — use a long random string in production (openssl rand -hex 64)
JWT_SECRET=change_me_in_production_use_openssl_rand_hex_64
# Refresh token secret — different from JWT_SECRET
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Stripe (optional — billing features) ────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Shopify Connector ────────────────────────────────────────────────────────
# Shopify webhook HMAC secret (from Shopify Partner Dashboard > Webhooks)
SHOPIFY_API_SECRET=your_shopify_api_secret

# ── WooCommerce Connector ─────────────────────────────────────────────────────
# WooCommerce webhook secret (set in WooCommerce > Settings > Advanced > Webhooks)
WOO_WEBHOOK_SECRET=your_woo_webhook_secret

# ── Email (optional — alert notifications) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@your-domain.com
